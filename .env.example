# AnyRouter provider for Hermes Agent — copy into ~/.hermes/.env
ANYROUTER_API_KEY=sk-your-key-here

# Optional: override the default https://anyrouter.dev/api/v1 endpoint
# ANYROUTER_BASE_URL=https://your-relay.example/v1

# Optional: opt in to app-attribution headers (public app rankings credit)
# ANYROUTER_APP_ATTRIBUTION=1
